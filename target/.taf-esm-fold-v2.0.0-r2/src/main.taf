<taf-app:container:ghcr.io/taffish/esm-fold:2.0.0-r2$@[docker/podman: --platform linux/amd64][docker/podman: -e "TORCH_HOME=${TORCH_HOME:-$HOME/.cache/taffish/esm-fold/torch}"][apptainer: --env "TORCH_HOME=${TORCH_HOME:-$HOME/.cache/taffish/esm-fold/torch}"][docker: $(taf_esm_gpu="${TAFFISH_ESM_FOLD_GPU:-auto}"; if test "$taf_esm_gpu" = 1 || test "$taf_esm_gpu" = true || test "$taf_esm_gpu" = TRUE || test "$taf_esm_gpu" = yes || test "$taf_esm_gpu" = YES || test "$taf_esm_gpu" = on || test "$taf_esm_gpu" = ON; then printf -- '--gpus all'; elif test "$taf_esm_gpu" = auto || test -z "$taf_esm_gpu"; then if test "$(uname -s 2>/dev/null)" = Linux && { test -e /dev/nvidiactl || test -e /proc/driver/nvidia/version || command -v nvidia-smi >/dev/null 2>&1; }; then printf -- '--gpus all'; fi; fi)][podman: $(taf_esm_gpu="${TAFFISH_ESM_FOLD_GPU:-auto}"; if test "$taf_esm_gpu" = 1 || test "$taf_esm_gpu" = true || test "$taf_esm_gpu" = TRUE || test "$taf_esm_gpu" = yes || test "$taf_esm_gpu" = YES || test "$taf_esm_gpu" = on || test "$taf_esm_gpu" = ON; then printf -- '--device nvidia.com/gpu=all'; elif test "$taf_esm_gpu" = auto || test -z "$taf_esm_gpu"; then if test "$(uname -s 2>/dev/null)" = Linux && { test -e /dev/nvidiactl || test -e /proc/driver/nvidia/version || command -v nvidia-smi >/dev/null 2>&1; }; then printf -- '--device nvidia.com/gpu=all'; fi; fi)][apptainer: $(taf_esm_gpu="${TAFFISH_ESM_FOLD_GPU:-auto}"; if test "$taf_esm_gpu" = 1 || test "$taf_esm_gpu" = true || test "$taf_esm_gpu" = TRUE || test "$taf_esm_gpu" = yes || test "$taf_esm_gpu" = YES || test "$taf_esm_gpu" = on || test "$taf_esm_gpu" = ON; then printf -- '--nv'; elif test "$taf_esm_gpu" = auto || test -z "$taf_esm_gpu"; then if test "$(uname -s 2>/dev/null)" = Linux && { test -e /dev/nvidiactl || test -e /proc/driver/nvidia/version || command -v nvidia-smi >/dev/null 2>&1; }; then printf -- '--nv'; fi; fi)]>
esm-fold ::*ARGV*::
