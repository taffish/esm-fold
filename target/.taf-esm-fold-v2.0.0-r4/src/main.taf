<taf-app:container:ghcr.io/taffish/esm-fold:2.0.0-r4$@[docker/podman: --platform linux/amd64][docker/podman: $(taf_esm_torch="${TAFFISH_ESM_FOLD_TORCH_HOME:-${TORCH_HOME:-}}"; taf_esm_explicit=0; if test -n "$taf_esm_torch"; then taf_esm_explicit=1; else for taf_esm_candidate in "${HOME}/.cache/taffish/esm-fold/torch" "${HOME}/.local/share/taffish/models/esm-fold/torch" "/usr/local/share/taffish/models/esm-fold/torch" "/opt/taffish/models/esm-fold/torch"; do if test -d "$taf_esm_candidate"; then taf_esm_torch="$taf_esm_candidate"; break; fi; done; fi; if test -z "$taf_esm_torch"; then taf_esm_torch="${HOME}/.cache/taffish/esm-fold/torch"; mkdir -p "$taf_esm_torch" 2>/dev/null || true; fi; printf -- '-e TORCH_HOME=%s' "$taf_esm_torch"; taf_esm_auto="${TAFFISH_ESM_FOLD_AUTO_MOUNT:-1}"; if test "$taf_esm_auto" = 0 || test "$taf_esm_auto" = false || test "$taf_esm_auto" = FALSE || test "$taf_esm_auto" = no || test "$taf_esm_auto" = NO || test "$taf_esm_auto" = off || test "$taf_esm_auto" = OFF; then exit 0; fi; if test -d "$taf_esm_torch"; then taf_esm_mount="$(cd "$taf_esm_torch" 2>/dev/null && pwd -P)"; printf -- ' --volume=%s:%s' "$taf_esm_mount" "$taf_esm_torch"; elif test "$taf_esm_explicit" = 1; then printf >&2 'taf-esm-fold: TAFFISH_ESM_FOLD_TORCH_HOME/TORCH_HOME does not exist or is not a directory: %s\n' "$taf_esm_torch"; fi)][apptainer: $(taf_esm_torch="${TAFFISH_ESM_FOLD_TORCH_HOME:-${TORCH_HOME:-}}"; taf_esm_explicit=0; if test -n "$taf_esm_torch"; then taf_esm_explicit=1; else for taf_esm_candidate in "${HOME}/.cache/taffish/esm-fold/torch" "${HOME}/.local/share/taffish/models/esm-fold/torch" "/usr/local/share/taffish/models/esm-fold/torch" "/opt/taffish/models/esm-fold/torch"; do if test -d "$taf_esm_candidate"; then taf_esm_torch="$taf_esm_candidate"; break; fi; done; fi; if test -z "$taf_esm_torch"; then taf_esm_torch="${HOME}/.cache/taffish/esm-fold/torch"; mkdir -p "$taf_esm_torch" 2>/dev/null || true; fi; printf -- '--env=TORCH_HOME=%s' "$taf_esm_torch"; taf_esm_auto="${TAFFISH_ESM_FOLD_AUTO_MOUNT:-1}"; if test "$taf_esm_auto" = 0 || test "$taf_esm_auto" = false || test "$taf_esm_auto" = FALSE || test "$taf_esm_auto" = no || test "$taf_esm_auto" = NO || test "$taf_esm_auto" = off || test "$taf_esm_auto" = OFF; then exit 0; fi; if test -d "$taf_esm_torch"; then taf_esm_mount="$(cd "$taf_esm_torch" 2>/dev/null && pwd -P)"; printf -- ' --bind=%s:%s' "$taf_esm_mount" "$taf_esm_torch"; elif test "$taf_esm_explicit" = 1; then printf >&2 'taf-esm-fold: TAFFISH_ESM_FOLD_TORCH_HOME/TORCH_HOME does not exist or is not a directory: %s\n' "$taf_esm_torch"; fi)][docker: $(taf_esm_gpu="${TAFFISH_ESM_FOLD_GPU:-auto}"; if test "$taf_esm_gpu" = 1 || test "$taf_esm_gpu" = true || test "$taf_esm_gpu" = TRUE || test "$taf_esm_gpu" = yes || test "$taf_esm_gpu" = YES || test "$taf_esm_gpu" = on || test "$taf_esm_gpu" = ON; then printf -- '--gpus all'; elif test "$taf_esm_gpu" = auto || test -z "$taf_esm_gpu"; then if test "$(uname -s 2>/dev/null)" = Linux && { test -e /dev/nvidiactl || test -e /proc/driver/nvidia/version || command -v nvidia-smi >/dev/null 2>&1; }; then printf -- '--gpus all'; fi; fi)][podman: $(taf_esm_gpu="${TAFFISH_ESM_FOLD_GPU:-auto}"; if test "$taf_esm_gpu" = 1 || test "$taf_esm_gpu" = true || test "$taf_esm_gpu" = TRUE || test "$taf_esm_gpu" = yes || test "$taf_esm_gpu" = YES || test "$taf_esm_gpu" = on || test "$taf_esm_gpu" = ON; then printf -- '--device nvidia.com/gpu=all'; elif test "$taf_esm_gpu" = auto || test -z "$taf_esm_gpu"; then if test "$(uname -s 2>/dev/null)" = Linux && { test -e /dev/nvidiactl || test -e /proc/driver/nvidia/version || command -v nvidia-smi >/dev/null 2>&1; }; then printf -- '--device nvidia.com/gpu=all'; fi; fi)][apptainer: $(taf_esm_gpu="${TAFFISH_ESM_FOLD_GPU:-auto}"; if test "$taf_esm_gpu" = 1 || test "$taf_esm_gpu" = true || test "$taf_esm_gpu" = TRUE || test "$taf_esm_gpu" = yes || test "$taf_esm_gpu" = YES || test "$taf_esm_gpu" = on || test "$taf_esm_gpu" = ON; then printf